    "@spatulox/simplediscordbot": "^4.0.2",
    "discord.js": "^14.26.0",
    "discord.js-rate-limiter": "^1.3.2",
    "dotenv": "^18.0.5",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-schedule": "^2.1.7",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "keywords": []
}
