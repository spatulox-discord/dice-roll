{
  "name": "dice-roll",
  "version": "1.0.0",
  "description": "Discord dice roller bot built on @spatulox/simplediscordbot",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "startjs": "node ./dist/index.js",
    "start": "clear && npm run build && npm run startjs",
    "dev": "nodemon -e ts --watch src --exec \"tsc && node ./dist/index.js\"",
    "dim": "dim",
    "test": "tsc && node --test \"dist/**/*.test.js\""
  },
  "author": "Spatulox",
  "license": "ISC",
  "dependencies": {
    "@discordjs/builders": "^1.9.0",
    "@spatulox/discord-interaction-manager": "^2.5.0",
    "@spatulox/discord-module": "^0.11.1",
    "@spatulox/simplediscordbot": "^5.0.0",
    "@spatulox/utils": "^0.3.0",
    "discord.js": "^14.26.0",
    "dotenv": "^18.0.8",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-schedule": "^2.1.7",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "keywords": []
}
