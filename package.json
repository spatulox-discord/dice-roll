{
  "name": "discord-bot-template",
  "version": "1.0.0",
  "description": "Discord bot template built on @spatulox/simplediscordbot",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "startjs": "node ./dist/index.js",
    "start": "clear && npm run build && npm run startjs",
    "dev": "nodemon -e ts --exec ts-node src/index.ts",
    "dim": "dim"
  },
