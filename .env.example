# Bot token, from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# Application (client) id, used by the `dim` CLI to deploy interactions
DISCORD_BOT_CLIENTID=
# true (or 1) = dev mode : loads handler/*_dev/ and the DEV ids of src/constantes.ts
# anything else (false, empty...) = production
DISCORD_BOT_DEV=true
# Folder scanned by the `dim` CLI for the interaction json files
DISCORD_INTERACTION_FOLDER=./handler
# Prefix (relative to the cwd) where CacheManager creates its .utilscache folder
CACHE_FOLDER=
