# Bot token, from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Optional : true (or 1) = dev mode, loads handlers/*_dev/ (/roll_dev, /info_dev) and the DEV ids of src/constantes.ts
# Absent or anything else = production (/roll, /info)
# DISCORD_BOT_DEV=true

# Optional : prefix (relative to the cwd) where CacheManager creates its .utilscache folder
# CACHE_FOLDER=
